# Copy to .env for local development.
PORT=3000
WEB_ORIGIN=http://localhost:4200
SESSION_TTL_DAYS=30

# Local test account for checking the app by hand (create it on the sign-up page; never use in production):
#   name: Demo Electrician  company: Demo Electrical  email: demo@electro-house.test  password: demo-pass-2026

# ── Option A: Docker (docker compose up -d) ─────────────────────────────
DATABASE_URL=postgresql://electro:electro@localhost:5432/electro?schema=public
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=electro-plans
S3_ACCESS_KEY_ID=electro
S3_SECRET_ACCESS_KEY=electro-dev-secret
# true for MinIO; false for AWS S3 / Cloudflare R2
S3_FORCE_PATH_STYLE=true

# ── Option B: no Docker ──────────────────────────────────────────────────
# 1. In apps/api run: npx prisma dev --name electro-house --detach   (note the TCP port it prints)
# 2. Create a database named "electro" on that server (never use template1: new databases are copied from it):
#      npm run db:create-local -w @electro/api
# 3. Use it here:
# DATABASE_URL=postgres://postgres:postgres@localhost:51214/electro?sslmode=disable
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.storage
