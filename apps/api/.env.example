# Copy to .env for local development.
PORT=3000
WEB_ORIGIN=http://localhost:4200
SESSION_TTL_DAYS=30

# Local test account for checking the app by hand (create it on the sign-up page; never use in production):
#   name: Demo Electrician  company: Demo Electrical  email: demo@electro-house.test  password: demo-pass-2026
#   second company, for checking that companies cannot see each other's data:
#   name: Second Tester     company: Second Electrical  email: second@electro-house.test  password: second-pass-2026

# ── Option A: Docker (docker compose up -d) ─────────────────────────────
DATABASE_URL=postgresql://electro:electro@localhost:5432/electro?schema=public
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=electro-plans
S3_ACCESS_KEY_ID=electro
S3_SECRET_ACCESS_KEY=electro-dev-secret
# true for MinIO; false for AWS S3 / Cloudflare R2
S3_FORCE_PATH_STYLE=true

# ── Option B: no Docker ──────────────────────────────────────────────────
# In apps/api run: npx prisma dev --name electro-house --detach
# It prints a TCP database URL and runs a separate shadow database on the next port (Prisma needs it for migrations).
# Note: a prisma dev server holds ONE database; the database name in the URL is ignored.
# DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:51215/template1?sslmode=disable
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.storage

# ── Billing ─────────────────────────────────────────────────────────────
# dev = simulated checkout for local testing (no real payments, refused in production).
# none = billing switched off: every company has full access (free test deployments, see docs/DEPLOY.md).
BILLING_PROVIDER=dev
# Paddle Billing (BILLING_PROVIDER=paddle). Create a sandbox account, a product with two per-user prices
# (EUR 29/month and EUR 290/year), a default payment link, and a webhook to https://<api>/api/billing/webhooks/paddle.
# PADDLE_ENV=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_MONTHLY=pri_...
# PADDLE_PRICE_YEARLY=pri_...

# Stream plan PDFs through the API instead of presigned S3 URLs (no bucket CORS needed; used on Render).
# S3_PROXY_READS=true
