// Electro House database schema. See docs/ARCHITECTURE.md §4.
// Every business table is scoped to an Organization (the paying customer).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ── Accounts & tenancy ────────────────────────────────────────

model Organization {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime     @default(now())
  /// Company settings: currency, VAT, markup, labour rate, allowances, title-block details. See `organizationSettingsSchema`.
  settings  Json         @default("{}")
  // ── Subscription (see packages/shared/src/billing). Kept in sync by provider webhooks.
  /// trialing | active | past_due | canceled | expired
  subscriptionStatus     String    @default("trialing")
  trialEndsAt            DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  pastDueSince           DateTime?
  /// month | year
  billingInterval        String?
  seats                  Int       @default(1)
  /// "paddle" | "dev"
  billingProvider        String?
  providerCustomerId     String?
  providerSubscriptionId String?   @unique
  members   Membership[]
  clients   Client[]
  projects  Project[]
  files     StoredFile[]
  materials Material[]
  materialRules MaterialRule[]
  invitations   Invitation[]
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  passwordHash String
  /// Company opened at sign-in (the one used last). Null = the first membership.
  lastOrganizationId String? @db.Uuid
  /// Interface language: "sq" (Albanian, default) or "en".
  language     String       @default("sq")
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     Session[]
  invitationsSent Invitation[]
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           MemberRole   @default(OWNER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

/// Server-side session. `tokenHash` is the SHA-256 of the random cookie token; the raw token is never stored.
model Session {
  id             String   @id @default(uuid()) @db.Uuid
  tokenHash      String   @unique
  userId         String   @db.Uuid
  organizationId String   @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Clients & projects ────────────────────────────────────────

model Client {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects       Project[]

  @@index([organizationId, name])
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  clientId        String        @db.Uuid
  name            String
  propertyAddress String?
  description     String?
  status          ProjectStatus @default(PLANNING)
  settings        Json          @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  floors          Floor[]
  circuits        Circuit[]
  floorLinks      FloorLink[]

  @@index([organizationId, clientId])
  @@index([organizationId, updatedAt])
}

// ── Floors & plan files ───────────────────────────────────────

model Floor {
  id                    String      @id @default(uuid()) @db.Uuid
  projectId             String      @db.Uuid
  name                  String
  sortOrder             Int
  planFileId            String?     @db.Uuid
  planPage              Int         @default(1)
  /// 0 | 90 | 180 | 270. A view setting; never applied to stored coordinates.
  planRotation          Int         @default(0)
  /// Validated by `calibrationSchema` in @electro/shared. Null = not calibrated.
  calibration           Json?
  calibrationNeedsCheck Boolean     @default(false)
  /// Protects the plan page and an existing calibration from accidental changes.
  backgroundLocked      Boolean     @default(false)
  /// Incremented on every saved change; used for optimistic concurrency (409 on mismatch).
  revision              Int         @default(0)
  /// Revision of the drawing (components, layers); separate from settings so the two autosaves never conflict.
  drawingRevision       Int         @default(0)
  /// Floor-to-ceiling height for vertical cable drops in the bill of materials.
  ceilingHeightMm       Int         @default(2600)
  /// "ceiling" | "floor": where cables run on this floor.
  cableRouting          String      @default("ceiling")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  project               Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planFile              StoredFile? @relation(fields: [planFileId], references: [id], onDelete: SetNull)
  layers                Layer[]
  components            Component[]
  wires                 Wire[]

  @@index([projectId, sortOrder])
}

model StoredFile {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  storageKey     String       @unique
  originalName   String
  mimeType       String
  sizeBytes      Int
  pageCount      Int
  sha256         String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  floors         Floor[]

  @@index([organizationId])
}

// ── Drawing ───────────────────────────────────────────────────

/// Per-floor layer state. Rows exist only for layers whose state differs from the default (visible, unlocked).
model Layer {
  id        String  @id @default(uuid()) @db.Uuid
  floorId   String  @db.Uuid
  key       String
  visible   Boolean @default(true)
  locked    Boolean @default(false)
  floor     Floor   @relation(fields: [floorId], references: [id], onDelete: Cascade)

  @@unique([floorId, key])
}

/// A placed electrical component. Position is in plan coordinates (PDF points of the plan page).
model Component {
  id            String   @id @db.Uuid
  floorId       String   @db.Uuid
  typeKey       String
  typeVersion   Int
  layerKey      String
  label         String?
  x             Float
  y             Float
  rotation      Float    @default(0)
  mountHeightMm Int?
  description   String?
  /// Validated against the component type's schema in @electro/shared.
  properties    Json     @default("{}")
  circuitId     String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  floor         Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  circuit       Circuit? @relation("ComponentCircuit", fields: [circuitId], references: [id], onDelete: SetNull)
  wiresFrom     Wire[]   @relation("WireFrom")
  wiresTo       Wire[]   @relation("WireTo")
  boardOf       Circuit[] @relation("CircuitBoard")
  linksFrom     FloorLink[] @relation("LinkFrom")
  linksTo       FloorLink[] @relation("LinkTo")

  @@index([floorId])
}

/// A cable route. Each end is either connected to a component (a real foreign key, so the connection is data,
/// not just a drawn line) or a free point. Interior bend points are stored as JSON [{x,y}] in plan coordinates.
model Wire {
  id              String     @id @db.Uuid
  floorId         String     @db.Uuid
  label           String?
  fromComponentId String?    @db.Uuid
  fromPortId      String?
  fromX           Float
  fromY           Float
  toComponentId   String?    @db.Uuid
  toPortId        String?
  toX             Float
  toY             Float
  points          Json       @default("[]")
  /// Cable data (type, conductors, cross-section, voltage, installation method, colour, line style).
  cable           Json
  circuitId       String?    @db.Uuid
  description     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  floor           Floor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  fromComponent   Component? @relation("WireFrom", fields: [fromComponentId], references: [id], onDelete: Restrict)
  toComponent     Component? @relation("WireTo", fields: [toComponentId], references: [id], onDelete: Restrict)
  circuit         Circuit?   @relation("WireCircuit", fields: [circuitId], references: [id], onDelete: SetNull)

  @@index([floorId])
  @@index([fromComponentId])
  @@index([toComponentId])
}

// ── Electrical management ─────────────────────────────────────

/// A circuit belongs to the project (it may span floors) and is fed from a distribution board component.
model Circuit {
  id                String      @id @default(uuid()) @db.Uuid
  projectId         String      @db.Uuid
  number            String
  name              String
  category          String
  boardComponentId  String?     @db.Uuid
  phase             String
  voltage           Float
  protection        String
  breakerRatingA    Float?
  breakerCurve      String?
  rcdGroup          String?
  residualCurrentMa Float?
  cableType         String?
  crossSectionMm2   Float?
  manualLoadW       Float?
  description       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board             Component?  @relation("CircuitBoard", fields: [boardComponentId], references: [id], onDelete: SetNull)
  components        Component[] @relation("ComponentCircuit")
  wires             Wire[]      @relation("WireCircuit")
  links             FloorLink[]

  @@index([projectId])
}

/// A cable between components on different floors (vertical runs, board-to-board feeds).
model FloorLink {
  id              String    @id @default(uuid()) @db.Uuid
  projectId       String    @db.Uuid
  fromComponentId String    @db.Uuid
  toComponentId   String    @db.Uuid
  lengthM         Float
  cable           Json
  circuitId       String?   @db.Uuid
  description     String?
  createdAt       DateTime  @default(now())
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromComponent   Component @relation("LinkFrom", fields: [fromComponentId], references: [id], onDelete: Cascade)
  toComponent     Component @relation("LinkTo", fields: [toComponentId], references: [id], onDelete: Cascade)
  circuit         Circuit?  @relation(fields: [circuitId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

// ── Prices & materials ────────────────────────────────────────

/// A line of the company price list. Prices are net, in the organization currency.
model Material {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  code           String?
  name           String
  unit           String
  unitPrice      Decimal        @db.Decimal(12, 4)
  packSize       Decimal?       @db.Decimal(12, 3)
  category       String?
  archived       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules          MaterialRule[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

/// What a component type ("component:<typeKey>") or a cable ("cable:<type>|<cores>|<mm²>", parts may be "*") consumes.
model MaterialRule {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  target         String
  materialId     String       @db.Uuid
  quantity       Decimal      @db.Decimal(12, 4)
  labourMinutes  Decimal      @default(0) @db.Decimal(10, 2)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([organizationId, target])
}

// ── Billing ───────────────────────────────────────────────────

/// Every verified webhook event, so a retried delivery is applied only once.
model BillingEvent {
  id             String   @id @default(uuid()) @db.Uuid
  provider       String
  eventId        String
  type           String
  organizationId String?  @db.Uuid
  receivedAt     DateTime @default(now())
  payload        Json

  @@unique([provider, eventId])
  @@index([organizationId])
}

// ── File storage in the database ─────────────────────────────

/// File contents for STORAGE_DRIVER=database (small deployments without object storage). Key = StoredFile.storageKey.
model FileBlob {
  key       String   @id
  data      Bytes
  createdAt DateTime @default(now())
}

// ── Team ──────────────────────────────────────────────────────

/// Single-use invitation to join a company. Only the SHA-256 of the link token is stored.
model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           MemberRole
  tokenHash      String       @unique
  invitedById    String       @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}
